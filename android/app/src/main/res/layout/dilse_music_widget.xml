<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Background with rounded corners and dynamic dominant color tint -->
    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/dilse_widget_background" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Top Section: Album Cover on Left, Controls & Title on Right -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Album Cover to the left of the rectangle widget -->
            <ImageView
                android:id="@+id/widget_album_art"
                android:layout_width="86dp"
                android:layout_height="86dp"
                android:scaleType="centerCrop"
                android:background="#1E1E28"
                android:contentDescription="Album Art"
                android:src="@drawable/ic_stat_music" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp"
                android:gravity="center_vertical">

                <!-- Title in center of remaining space -->
                <TextView
                    android:id="@+id/widget_song_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="DilSe Music"
                    android:textColor="#FFFFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:ellipsize="marquee" />

                <!-- Artist name at bottom of title with less font size -->
                <TextView
                    android:id="@+id/widget_song_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Tap to play"
                    android:textColor="#B3FFFFFF"
                    android:textSize="11sp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:layout_marginTop="2dp" />

                <!-- Controls in exact order: 1. Shuffle, 2. Previous, 3. Play/Pause, 4. Next, 5. Repeat -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="6dp">

                    <!-- 1. Shuffle -->
                    <ImageView
                        android:id="@+id/widget_btn_shuffle"
                        android:layout_width="0dp"
                        android:layout_height="32dp"
                        android:layout_weight="1"
                        android:padding="5dp"
                        android:background="@android:color/transparent"
                        android:src="@drawable/ic_widget_shuffle"
                        android:contentDescription="Shuffle" />

                    <!-- 2. Previous -->
                    <ImageView
                        android:id="@+id/widget_btn_prev"
                        android:layout_width="0dp"
                        android:layout_height="32dp"
                        android:layout_weight="1"
                        android:padding="5dp"
                        android:background="@android:color/transparent"
                        android:src="@drawable/audio_service_skip_previous"
                        android:contentDescription="Previous" />

                    <!-- 3. Play / Pause -->
                    <ImageView
                        android:id="@+id/widget_btn_play_pause"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_weight="1.2"
                        android:padding="3dp"
                        android:background="@android:color/transparent"
                        android:src="@drawable/audio_service_play_arrow"
                        android:contentDescription="Play/Pause" />

                    <!-- 4. Next -->
                    <ImageView
                        android:id="@+id/widget_btn_next"
                        android:layout_width="0dp"
                        android:layout_height="32dp"
                        android:layout_weight="1"
                        android:padding="5dp"
                        android:background="@android:color/transparent"
                        android:src="@drawable/audio_service_skip_next"
                        android:contentDescription="Next" />

                    <!-- 5. Repeat (single & playlist loop) -->
                    <ImageView
                        android:id="@+id/widget_btn_repeat"
                        android:layout_width="0dp"
                        android:layout_height="32dp"
                        android:layout_weight="1"
                        android:padding="5dp"
                        android:background="@android:color/transparent"
                        android:src="@drawable/ic_widget_repeat"
                        android:contentDescription="Repeat" />
                </LinearLayout>

                <!-- Responsive Scrubber at the bottom of controls on right side of album cover -->
                <ProgressBar
                    android:id="@+id/widget_scrubber"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="5dp"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/widget_scrubber_progress" />

                <!-- Current Time (elapsed) and Total Duration -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="2dp">

                    <TextView
                        android:id="@+id/widget_time_current"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="start"
                        android:text="0:00"
                        android:textColor="#A6FFFFFF"
                        android:textSize="9sp" />

                    <TextView
                        android:id="@+id/widget_time_total"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="0:00"
                        android:textColor="#A6FFFFFF"
                        android:textSize="9sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Bottom Section: Top 5 Playlists as app icon size across bottom of all things -->
        <LinearLayout
            android:id="@+id/widget_playlists_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:gravity="center">

            <!-- Playlist 1 -->
            <LinearLayout
                android:id="@+id/widget_playlist_item_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <ImageView
                    android:id="@+id/widget_playlist_icon_1"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:scaleType="centerCrop"
                    android:background="#222230"
                    android:src="@drawable/ic_playlist_placeholder" />
                <TextView
                    android:id="@+id/widget_playlist_title_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Mix 1"
                    android:textColor="#CCFFFFFF"
                    android:textSize="9.5sp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Playlist 2 -->
            <LinearLayout
                android:id="@+id/widget_playlist_item_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <ImageView
                    android:id="@+id/widget_playlist_icon_2"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:scaleType="centerCrop"
                    android:background="#222230"
                    android:src="@drawable/ic_playlist_placeholder" />
                <TextView
                    android:id="@+id/widget_playlist_title_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Telugu"
                    android:textColor="#CCFFFFFF"
                    android:textSize="9.5sp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Playlist 3 -->
            <LinearLayout
                android:id="@+id/widget_playlist_item_3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <ImageView
                    android:id="@+id/widget_playlist_icon_3"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:scaleType="centerCrop"
                    android:background="#222230"
                    android:src="@drawable/ic_playlist_placeholder" />
                <TextView
                    android:id="@+id/widget_playlist_title_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Global"
                    android:textColor="#CCFFFFFF"
                    android:textSize="9.5sp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Playlist 4 -->
            <LinearLayout
                android:id="@+id/widget_playlist_item_4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <ImageView
                    android:id="@+id/widget_playlist_icon_4"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:scaleType="centerCrop"
                    android:background="#222230"
                    android:src="@drawable/ic_playlist_placeholder" />
                <TextView
                    android:id="@+id/widget_playlist_title_4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Favorites"
                    android:textColor="#CCFFFFFF"
                    android:textSize="9.5sp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Playlist 5 -->
            <LinearLayout
                android:id="@+id/widget_playlist_item_5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <ImageView
                    android:id="@+id/widget_playlist_icon_5"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:scaleType="centerCrop"
                    android:background="#222230"
                    android:src="@drawable/ic_playlist_placeholder" />
                <TextView
                    android:id="@+id/widget_playlist_title_5"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Chill"
                    android:textColor="#CCFFFFFF"
                    android:textSize="9.5sp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
