<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/dilse_widget_background"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Album Cover -->
        <ImageView
            android:id="@+id/widget_album_art"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:scaleType="centerCrop"
            android:background="#222230"
            android:contentDescription="Album Art"
            android:src="@drawable/ic_stat_music" />

        <!-- Track Info & Controls -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DILSE MUSIC"
                android:textColor="#80FFFFFF"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <TextView
                android:id="@+id/widget_song_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="DilSe Music"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="marquee"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/widget_song_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tap to play"
                android:textColor="#B3FFFFFF"
                android:textSize="12sp"
                android:singleLine="true"
                android:ellipsize="end"
                android:layout_marginTop="1dp" />

            <!-- Controls: Previous, Play/Pause, Next -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical|start"
                android:layout_marginTop="8dp">

                <ImageView
                    android:id="@+id/widget_btn_prev"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:padding="6dp"
                    android:background="@android:color/transparent"
                    android:src="@drawable/audio_service_skip_previous"
                    android:contentDescription="Previous" />

                <ImageView
                    android:id="@+id/widget_btn_play_pause"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:padding="4dp"
                    android:layout_marginStart="10dp"
                    android:background="@android:color/transparent"
                    android:src="@drawable/audio_service_play_arrow"
                    android:contentDescription="Play/Pause" />

                <ImageView
                    android:id="@+id/widget_btn_next"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:padding="6dp"
                    android:layout_marginStart="10dp"
                    android:background="@android:color/transparent"
                    android:src="@drawable/audio_service_skip_next"
                    android:contentDescription="Next" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
